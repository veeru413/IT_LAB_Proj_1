# ---------------------------------------------------------------------------
# Backend environment configuration
#
# Copy this file to `.env` (the setup script does it automatically):
#     cp .env.example .env
#
# NEVER commit the real `.env` file - it is listed in .gitignore.
# ---------------------------------------------------------------------------

# Local SQLite database file.
# The path is resolved relative to `backend/prisma/`, so this creates
# `backend/prisma/dev.db`. The database is 100% local - no cloud services.
DATABASE_URL="file:./dev.db"

# Secret used to sign JSON Web Tokens.
# MUST be replaced with a long random string in any real deployment.
JWT_SECRET="dev-only-secret-change-this-in-production-min-16-chars"

# How long an issued access token stays valid (zeit/ms format: 15m, 2h, 7d ...).
JWT_EXPIRES_IN="7d"

# Port the Express API listens on.
PORT=5000

# Origin(s) allowed by CORS. Comma-separate to allow several.
CLIENT_URL="http://localhost:5173"

# development | production | test
NODE_ENV="development"

# bcrypt cost factor. 10-12 is the sane range; higher = slower logins.
BCRYPT_SALT_ROUNDS=10
